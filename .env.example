# Copy to .env and fill in the two API keys.
# A value set here overrides the same key in config/$APP_ENV.yaml.
# Commented lines leave the YAML value in place.
#
# .env is gitignored. This example is not.

# Selects config/<APP_ENV>.yaml. docker-compose.yml passes this into the
# container and defaults to development when it is unset.
# development | staging | production
APP_ENV=development

# Ingestion mode. Unset or blank defaults to websocket.
# websocket: stream Navixy, fail over to API polling, probe back.
# poll: API polling only. The websocket is never opened.
# Development, staging, and production configs set websocket.
NAVIXY_MODE=websocket

# Comma-separated Navixy tracker ids. A non-empty list wins and discovery
# is skipped. Empty discovers ids from tracker/list instead of going idle.
# Discovery never subscribes to every tracker.
TRACKER_IDS=123456

# Seconds between tracker/list refreshes when TRACKER_IDS is empty.
# 0 discovers once at startup and does not refresh. Default 300.
NAVIXY_TRACKER_DISCOVERY_INTERVAL_SECONDS=300

# Seconds between REST polls. Used for poll mode and for failover polling.
POLL_INTERVAL_SECONDS=30

# Consecutive Navixy socket failures before websocket mode switches to poll.
# A connection that opens resets the streak. Publish errors do not count.
NAVIXY_FAILOVER_MAX_ATTEMPTS=5

# Exponential backoff: min(cap, initial * 2^(failure-1)) seconds.
NAVIXY_FAILOVER_BACKOFF_INITIAL_SECONDS=1
NAVIXY_FAILOVER_BACKOFF_CAP_SECONDS=30

# While polling after failover, how often to try the websocket again,
# and how long that socket must stay up before switching back.
NAVIXY_FAILOVER_PROBE_INTERVAL_SECONDS=60
NAVIXY_FAILOVER_HEALTHY_WINDOW_SECONDS=30

# Navixy HTTP API and websocket. Required secret: NAVIXY_API_KEY.
NAVIXY_BASE_URL=https://api.eu.navixy.com/v2
NAVIXY_WS_URL=wss://ws.navixy.com/events
NAVIXY_API_KEY=

# ChatSurfer. Required secret: CHAT_SURFER_API_KEY.
CHAT_SURFER_BASE_URL=https://chatsurfer.nro.mil
CHAT_SURFER_API_KEY=
CHAT_SURFER_DOMAIN_ID=chatsurferxmppunclass
CHAT_SURFER_ROOM_NAME=freedom_flag
CHAT_SURFER_ROOM_NAME_ENCRYPTED=freedom_flag_encrypted
CHAT_SURFER_NICKNAME=navtracker
CHAT_SURFER_CLASSIFICATION=UNCLASSIFIED//FOUO
CHAT_SURFER_USER_HIGH_CLASSIFICATION=UNCLASSIFIED//FOUO
CHAT_SURFER_CLIENT_CERT=/data/certs/client/tls.crt
CHAT_SURFER_CLIENT_KEY=/data/certs/client/tls.key
CHAT_SURFER_RATE_LIMIT=60
CHAT_SURFER_MAX_MESSAGE_SIZE=4000
# true or false. true publishes to the encrypted room.
CHAT_SURFER_ENCRYPTION_REQUIRED=true

# Crypto mode: pem, ssh, or fernet. Startup checks only the material that
# mode uses, and the error names the mode and the missing setting.
# pem and ssh require ENCRYPTION_CERT. They ignore FERNET_KEY.
# fernet requires FERNET_KEY. It ignores ENCRYPTION_CERT.
MODE=pem
# Required for pem and ssh. Public certificate or PEM/SSH public key.
ENCRYPTION_CERT=/data/certs/client/tls.crt
# Private-key path stored on settings. Outbound encryption does not read it.
ENCRYPTION_KEY=/data/certs/client/tls.key

# Only needed when MODE=fernet. Leave this blank for pem and ssh.
# pem and ssh do not require it and do not validate it.
# Url-safe base64-encoded 32-byte key.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# A blank value, or the YAML literal None, is unset. fernet mode fails at
# startup when FERNET_KEY is missing or not a valid Fernet key.
FERNET_KEY=

# --- Analytics process (config/analytics/$APP_ENV.yaml) ---
# The analytics service does not read Navixy. These override analytics YAML.

# ChatSurfer room reads. The path below is the documented ChatSurfer 4.24 route.
# Confirm it against docs/chatsurfer-api.md before turning reads on.
# Development YAML leaves reads off. Set this true to read rooms.
# Remove the line to use the YAML default (off in development unless a path
# and rooms are both set; on in staging and production when rooms are set).
CHAT_SURFER_READ_ENABLED=false
# {domainId} and {roomName} are URL-encoded path parameters. roomName may
# start with '#'.
CHAT_SURFER_READ_PATH=/api/chat/messages/{domainId}/{roomName}
# Once a message id has been seen, poll GET /api/chat/messages/{messageId}
# with numAfter set to this page size (1..1000) and numBefore=0.
CHAT_SURFER_READ_PAGE_PATH=/api/chat/messages/{messageId}
CHAT_SURFER_READ_PAGE_SIZE=100
# websocket (STOMP 1.2 at wss://<host>/ws/connect) or poll (REST).
# websocket fails over to REST after repeated socket failures, then probes back.
CHAT_SURFER_INGEST_MODE=websocket
# Startup search lookback in minutes. 0 skips POST /api/chatsearch/messages/search.
CHAT_SURFER_BACKFILL_MINUTES=60
# When true, drop messages that are not tagged EXERCISE.
CHAT_SURFER_EXERCISE_ONLY=false
# Extra bot nicknames to drop, besides this process's CHAT_SURFER_NICKNAME.
# SENT_BY_SYSTEM is always dropped.
CHAT_SURFER_SKIP_BOTS=
# Bounded per-room set of message ids and revision ids.
CHAT_SURFER_SEEN_LIMIT=2000
# Poll GET /api/dataspill/messages/scrubbed. A scrub retracts that message.
CHAT_SURFER_SCRUB_POLL_SECONDS=60
CHAT_SURFER_FAILOVER_MAX_ATTEMPTS=5
CHAT_SURFER_FAILOVER_BACKOFF_INITIAL_SECONDS=1
CHAT_SURFER_FAILOVER_BACKOFF_CAP_SECONDS=30
CHAT_SURFER_FAILOVER_PROBE_INTERVAL_SECONDS=60
# ChatSurfer rooms whose JSON bodies are GPS fixes. Comma-separated.
CHAT_SURFER_READ_ROOMS=
# TACREP rooms. Comma-separated. Empty disables TACREP polling.
CHAT_SURFER_TACREP_ROOMS=
ANALYTICS_PUBLISH_EVENTS=false
ANALYTICS_REFERENCE_DIR=/data/reference
ANALYTICS_HTTP_PORT=8080
ANALYTICS_CHAT_SPEED_UNIT=kmh
ANALYTICS_PUBLIC_BASE_URL=

# Clairvoyant GPS. Staging and production YAML enable it. Development does not.
# websocket fails over to GET /layers/{layer}/positions. poll never opens the socket.
CLAIRVOYANT_ENABLED=false
CLAIRVOYANT_MODE=websocket
CLAIRVOYANT_WS_URL=
CLAIRVOYANT_BASE_URL=
CLAIRVOYANT_API_KEY=
CLAIRVOYANT_LAYER=default
# Report layers, comma-separated. Polled only when CLAIRVOYANT_ENABLED=true.
CLAIRVOYANT_REPORT_LAYERS=

# Confidence. decay_per_day 0 leaves decay off.
ANALYTICS_CONFIDENCE_INITIAL_CONFIDENCE=0.2
ANALYTICS_CONFIDENCE_PROBABLE_AT=0.55
ANALYTICS_CONFIDENCE_CONFIRMED_AT=0.8
ANALYTICS_CONFIDENCE_WINDOW_SECONDS=86400
ANALYTICS_CONFIDENCE_DECAY_PER_DAY=0

# H3 hex grid. Resolution 9 matches TransloadOracle h3_resolution.
ANALYTICS_GRID_RESOLUTION=9
ANALYTICS_GRID_WINDOW_SECONDS=86400
ANALYTICS_GRID_DECAY_HALF_LIFE_SECONDS=0
ANALYTICS_GRID_HOTSPOT_SCORE=1.5

# Correlation. minimum_transload_speed_mps is stored and unused by scoring.
ANALYTICS_CORRELATION_WINDOW_MINUTES=45
ANALYTICS_CORRELATION_HIDE_GAP_MINUTES=20
ANALYTICS_CORRELATION_MINIMUM_SCORE=0.70
ANALYTICS_CORRELATION_MINIMUM_SOURCES=3
ANALYTICS_CORRELATION_MINIMUM_TRANSLOAD_SPEED_MPS=0.5

# Basemap. leaflet is the default and uses OpenStreetMap tiles.
# mapbox uses style mapbox/dark-v11 and requires MAPBOX_PUBLIC_TOKEN.
# none is the air-gapped option. xyz requires ANALYTICS_MAP_TILE_URL.
# osm is accepted as an alias of leaflet. Do not commit a tile API key.
NEXT_PUBLIC_MAP_PROVIDER=leaflet
ANALYTICS_MAP_PROVIDER=leaflet
MAPBOX_PUBLIC_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_SERVER_TOKEN=
ANALYTICS_MAPBOX_TOKEN=
ANALYTICS_MAP_TILE_URL=
ANALYTICS_MAP_ATTRIBUTION=
ANALYTICS_MAP_MIN_ZOOM=0
ANALYTICS_MAP_MAX_ZOOM=19
ANALYTICS_MAP_CENTER_LATITUDE=39.8283
ANALYTICS_MAP_CENTER_LONGITUDE=-98.5795
ANALYTICS_MAP_ZOOM=4

# Routing. osrm is the default and uses the public OSRM service.
# mapbox requires MAPBOX_SERVER_TOKEN. valhalla and graphhopper
# require ANALYTICS_ROUTING_BASE_URL. msr follows imported corridors.
ROUTING_PROVIDER=osrm
ANALYTICS_ROUTING_ENGINE=osrm
ANALYTICS_ROUTING_BASE_URL=https://router.project-osrm.org
ANALYTICS_ROUTING_TIMEOUT_SECONDS=15
ANALYTICS_ROUTING_CACHE_TTL_SECONDS=300
ANALYTICS_ROUTING_CACHE_SIZE=256
ANALYTICS_ROUTING_SNAP_METERS=500
ANALYTICS_ROUTING_JOIN_METERS=40

# Optional push to a frontend ingest URL. Off unless both are set.
ANALYTICS_FRONTEND_ENABLED=false
ANALYTICS_FRONTEND_INGEST_URL=

# Exercise coord card. YAML or CSV. Unset means no block ranges are loaded.
# See config/analytics/coord_card.example.yaml for the fake sample shape.
ANALYTICS_COORD_CARD=
# Published LOCATION for ChatSurfer. Default is 1 m MGRS with no spaces.
# mgrs and latlon map. ddmm (N6919 W11919) does not, and logs a warning.
# Precedence: analyst override, coord card output, these variables, then mgrs.
# ANALYTICS_OUTPUT_COORD_FORMAT=mgrs
# ANALYTICS_OUTPUT_MGRS_PRECISION_M=1
# ANALYTICS_OUTPUT_MGRS_SPACES=false
# ANALYTICS_OUTPUT_LATLON_DECIMALS=5
# ANALYTICS_OUTPUT_LATLON_SEPARATOR=space
# ANALYTICS_OUTPUT_LATLON_HEMISPHERE=suffix
ANALYTICS_COORD_MISMATCH_METERS=250
# nmi (nautical miles), km, or meters. A unit written on an ellipse field wins.
ANALYTICS_ELLIPSE_UNIT=nmi
# Added to magnetic ellipse orientation. East is positive. 0 keeps magnetic north.
ANALYTICS_MAGNETIC_DECLINATION=0
# Added to a pair score when one TACREP lists the other via CORRELATES TO. Capped at 1.
ANALYTICS_CORRELATION_EXPLICIT_LINK_WEIGHT=0.5
# CAT I is the most accurate. Compact radii: I:6m,II:15m,III:30m,IV:91m.
# The coord card cat_ce table replaces this when the card sets one.
ANALYTICS_CAT_CE=
# PHRASE:level:band:weight items, separated by semicolons. Empty keeps the defaults
# POSS LOW, POSS HIGH, PROB, and CERTAIN.
ANALYTICS_CONFIDENCE_TERMS=
# Per-type ChatSurfer rooms. Empty is unset. "-" is an explicit empty list.
# ANALYTICS_ROOMS_ADHOC_INGEST=room-adhoc-in
# ANALYTICS_ROOMS_ADHOC_PUBLISH=room-adhoc-out
# ANALYTICS_ROOMS_SITREP_INGEST=
# ANALYTICS_ROOMS_SITREP_PUBLISH=
# Used when the card and the per-type variables do not name a room.
# CHAT_SURFER_TACREP_ROOMS is the ingest default when this is unset.
ANALYTICS_ROOMS_DEFAULT_INGEST=
ANALYTICS_ROOMS_DEFAULT_PUBLISH=
# confidence:cat:types:sources:rooms rules separated by semicolons.
# POSS HIGH:1-2:ELINT::room-precise
ANALYTICS_PUBLISH_RULES=
# Publish again when a notice moves to a higher confidence rank.
ANALYTICS_PUBLISH_REPUBLISH_ON_HIGHER_LEVEL=true
# Subtracted from site confidence when a TAI is VACANT. 0 disables it.
ANALYTICS_VACANT_EVIDENCE_WEIGHT=0.25

# Tokens. Empty values fail closed on the API. Health stays open.
# The write token also grants read. Compose publishes the port, so set
# ANALYTICS_HTTP_HOST=0.0.0.0 there. The process default is 127.0.0.1.
ANALYTICS_READ_TOKEN=
ANALYTICS_WRITE_TOKEN=
ANALYTICS_WS_ORIGINS=
ANALYTICS_HTTP_HOST=127.0.0.1
ANALYTICS_MAX_BODY_BYTES=1048576
ANALYTICS_MAX_UPLOAD_BYTES=8388608
ANALYTICS_MAX_WS_BYTES=1048576
# Newest GPS fixes kept per vehicle after ANALYTICS_FIX_RETENTION_SECONDS.
# 0 keeps every fix that survived retention. Default 100.
ANALYTICS_MAX_FIXES_PER_VEHICLE=100
# Drop fixes older than this many seconds before each vehicle's newest fix.
# 0 disables the time window. Default 86400.
ANALYTICS_FIX_RETENTION_SECONDS=86400

# Report evidence weights.
ANALYTICS_REPORTS_WINDOW_SECONDS=86400
ANALYTICS_REPORTS_WEIGHT=0.1
ANALYTICS_REPORTS_TYPE_WEIGHT=0.12
ANALYTICS_REPORTS_CAP=0.3
